{
    "name": "mobile",
    "private": true,
    "type": "module",
    "main": "index.ts",
    "packageManager": "bun@1.4.3",
    "engines": {
        "bun": ">=1.4.3"
    },
    "scripts": {
        "start": "bun tools/compile/index.ts development && expo start",
        "android": "bun tools/compile/index.ts development && expo run:android",
        "ios": "bun tools/compile/index.ts development && expo run:ios",
        "export": "bun tools/compile/index.ts production && NODE_ENV=production expo export --platform android --output-dir .expo/export",
        "check": "biome ci . && bun tools/architecture/index.ts && bun tools/messages/index.ts && bun tools/specs/index.ts",
        "fmt": "biome check --write .",
        "typecheck": "bun tools/compile/index.ts production && tsc --noEmit -p . && tsc --noEmit -p tsconfig.tools.json",
        "test": "bun test",
        "compile": "bun tools/compile/index.ts production"
    },
    "dependencies": {
        "@expo/metro-runtime": "57.0.16",
        "@react-native-async-storage/async-storage": "2.2.0",
        "expo": "57.0.27",
        "expo-build-properties": "57.0.22",
        "expo-constants": "57.0.21",
        "expo-image-picker": "57.0.20",
        "expo-linking": "57.0.12",
        "expo-localization": "57.0.2",
        "expo-location": "57.0.20",
        "expo-notifications": "57.0.22",
        "expo-router": "57.0.25",
        "expo-secure-store": "57.0.4",
        "expo-splash-screen": "57.0.9",
        "expo-status-bar": "57.0.1",
        "lucide-react-native": "1.54.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-safe-area-context": "5.7.0",
        "react-native-screens": "4.26.0",
        "react-native-svg": "15.15.4",
        "react-native-web": "0.21.4",
        "zod": "4.6.5",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@types/bun": "1.4.2",
        "@types/react": "19.2.4",
        "typescript": "7.0.2"
    },
    "overrides": {
        "uuid": "11.1.1",
        "decode-uri-component": "0.5.0"
    }
}
