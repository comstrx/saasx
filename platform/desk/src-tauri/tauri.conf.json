{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desk",
  "identifier": "app.desk.host",
  "build": {
    "beforeDevCommand": "bun run serve",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/current"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "App",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
