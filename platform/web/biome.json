{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!next-env.d.ts",
      "!public",
      "!specs/**/brand/images",
      "!specs/**/brand/fonts",
      "!bun.lock"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "domains": {
      "project": "all",
      "next": "all",
      "react": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "off",
        "noUndeclaredDependencies": "off",
        "useUniqueElementIds": "off"
      },
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useReactFunctionComponents": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "performance": {
        "noImgElement": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": [
        "src/lib/spec/config.ts",
        "src/lib/spec/server.ts",
        "src/lib/spec/browser.ts",
        "src/types/spec.d.ts",
        "src/app/\\[locale\\]/layout.tsx",
        "src/app/\\[locale\\]/\\[\\[...path\\]\\]/blocks.tsx",
        "src/app/\\[locale\\]/\\[\\[...path\\]\\]/mount.ts",
        "src/app/\\[locale\\]/\\[\\[...path\\]\\]/warm.ts",
        "src/app/.well-known/\\[...path\\]/route.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off",
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    }
  ]
}
