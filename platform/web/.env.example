# Every variable is optional. The spec (specs/<name>/config) holds every address and switch.

# The spec folder to build; empty selects the first installed one.
NEXT_PUBLIC_SPEC=client

# The front credential the tenant admin mints (scope allow_fronts); without it every server-side call shares one bucket.
FRONT_KEY=
FRONT_SECRET=
# One credential per host when one deployment serves several tenants: "www.a.test=key:secret www.b.test=key:secret".
FRONT_KEYS=

# Development only: extra hosts the dev server may be opened on (the tenant is the request host, so a tenant's own host needs listing here or in /etc/hosts).
NEXT_DEV_ORIGINS=
# Development only: browse localhost as this tenant (the backend's domain table decides which data answers); ignored by every other build.
NEXT_PUBLIC_DEV_TENANT=

# Local tools only (tools/contract): the sandbox backend that records the contract samples.
CONTRACT_API=
CONTRACT_TENANT=
CONTRACT_OTP=
