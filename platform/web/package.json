{
    "name": "web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --hostname 0.0.0.0 --port 3001",
        "build": "next build && node tools/release/index.ts",
        "start": "node tools/start/index.ts",
        "check": "biome check . && node tools/architecture/index.ts && node tools/messages/index.ts && node tools/contract/index.ts && pnpm spec",
        "check:fix": "biome check --write .",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "node --test tests/*/index.ts",
        "test:update": "node --test --test-update-snapshots tests/*/index.ts",
        "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
        "spec": "node tools/specs/index.ts"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@phosphor-icons/react": "2.1.10",
        "@tanstack/react-virtual": "3.14.13",
        "embla-carousel-react": "8.6.0",
        "frimousse": "0.4.0",
        "libphonenumber-js": "1.13.14",
        "motion": "13.4.5",
        "next": "16.3.7",
        "next-intl": "4.14.7",
        "next-themes": "0.4.6",
        "pusher-js": "8.6.0",
        "react": "19.3.0",
        "react-day-picker": "10.0.1",
        "react-dom": "19.3.0",
        "server-only": "0.0.1",
        "tailwind-merge": "3.7.0",
        "tailwind-variants": "3.3.1",
        "zod": "4.6.5",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@babel/parser": "7.29.9",
        "@babel/types": "7.29.8",
        "@biomejs/biome": "2.5.14",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "24.13.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "babel-plugin-react-compiler": "1.0.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2"
    },
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=12 <13"
    }
}
