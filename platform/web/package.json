{
  "name": "web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun tools/compile/index.ts development && next dev --hostname 0.0.0.0 --port 3001",
    "build": "bun tools/compile/index.ts production && next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "check": "biome ci . && bun tools/architecture/index.ts && bun tools/messages/index.ts && bun tools/specs/index.ts",
    "fmt": "biome check --write .",
    "typecheck": "bun tools/compile/index.ts production && next typegen && tsc --noEmit",
    "test": "bun test",
    "compile": "bun tools/compile/index.ts production",
    "bench": "set -e; for file in benches/*.bench.ts; do bun \"$file\"; done"
  },
  "dependencies": {
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "7.0.2"
  }
}
