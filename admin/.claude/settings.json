{
    "permissions": {
        "allow": [
            "Bash(pnpm lint)",
            "Bash(pnpm lint:fix)",
            "Bash(pnpm typecheck)",
            "Bash(pnpm build)",
            "Bash(pnpm dev)",
            "Bash(pnpm test)",
            "Bash(pnpm exec biome:*)",
            "Bash(pnpm exec tsc:*)",
            "Bash(pnpm dlx shadcn:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git add .)",
            "Bash(git commit:*)"
        ],
        "deny": [
            "Bash(git push:*)",
            "Bash(git add -A:*)",
            "Bash(git add ..:*)",
            "Bash(rm -rf:*)",
            "Read(.env*)"
        ]
    }
}
