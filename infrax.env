PROJECT=saasx
CLOUD=aws
AWS_REGION=eu-north-1
BASE_DOMAIN=zainlak.com
HOST_PREFIX=saasx-
DNS_PROVIDER=cloudflare
GIT_REPO_URL=https://github.com/comstrx/saasx.git

SERVICES=laravel go rust node python
MODULES=postgresql mysql redis storage pgadmin4 phpmyadmin

SERVICE_LARAVEL_RUNTIME=laravel
SERVICE_LARAVEL_HOST=api horizon
SERVICE_LARAVEL_USES=postgresql redis storage
SERVICE_LARAVEL_CALLS=go rust node python
SERVICE_LARAVEL_PROCESSES=web horizon

SERVICE_GO_RUNTIME=go
SERVICE_GO_USES=postgresql
SERVICE_GO_CALLS=rust

SERVICE_RUST_RUNTIME=rust
SERVICE_RUST_USES=redis

SERVICE_NODE_RUNTIME=node
SERVICE_NODE_USES=mysql

SERVICE_PYTHON_RUNTIME=python
SERVICE_PYTHON_USES=postgresql storage
SERVICE_PYTHON_CALLS=node

PGADMIN4_HOST=pgadmin
PHPMYADMIN_HOST=phpmyadmin
