{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "High-performance API backend for saas platform.",
    "keywords": [],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.8",
        "laravel/horizon": "^5.47",
        "laravel/octane": "^2.17",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "symfony/http-client": "^8.1",
        "symfony/mailgun-mailer": "^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "app/Support",
            "app/Traits"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php artisan storage:link --ansi",
            "@php artisan migrate --force --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan octane:start --host=127.0.0.1 --port=8000 --workers=4 --max-requests=500 --watch"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan octane:start --host=127.0.0.1 --port=8000 --workers=4 --max-requests=500"
        ],
        "queue": [
            "@php artisan queue:work"
        ],
        "logs": [
            "@php artisan pail"
        ],
        "clear": [
            "@php artisan optimize:clear --ansi"
        ],
        "cache": [
            "@php artisan config:cache --ansi",
            "@php artisan event:cache --ansi",
            "@php artisan route:cache --ansi",
            "@php artisan view:cache --ansi"
        ],
        "fresh": [
            "@php artisan optimize:clear --ansi",
            "@php artisan migrate:fresh --seed --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --ansi"
        ],
        "check": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@php vendor/bin/pint --test",
            "@php artisan config:clear --ansi",
            "@php artisan test --ansi"
        ],
        "prod": [
            "@composer dump-autoload --optimize --classmap-authoritative",
            "@php artisan optimize:clear --ansi",
            "@php artisan config:cache --ansi",
            "@php artisan event:cache --ansi",
            "@php artisan route:cache --ansi",
            "@php artisan view:cache --ansi"
        ],
        "about-app": [
            "@php artisan about"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
